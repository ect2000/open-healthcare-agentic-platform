# Healthcare Agents Platform Configuration
# Copy this file to .env for local overrides

# Application Settings
HEALTHCARE_AGENTS_ENV=development
HEALTHCARE_AGENTS_LOG_LEVEL=INFO

# Local Model Provider & LLM Settings (M2 — Gemma 4 + Ollama)
MODEL_PROVIDER=ollama
MODEL_NAME=gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434
MODEL_TIMEOUT_SECONDS=120

# Retrieval Mode & Provider Settings (M4A — Live NPPES)
# Options: 'live' (queries public NPPES registry) or 'fixture' (isolated test fixtures)
RETRIEVAL_MODE=live
NPPES_API_URL=https://npiregistry.cms.hhs.gov/api/
NPPES_TIMEOUT_SECONDS=10
NPPES_MAX_RETRIES=2

