# Healthcare Agents Platform Configuration
# Copy this file to .env for local overrides

# Application Settings
HEALTHCARE_AGENTS_ENV=development
HEALTHCARE_AGENTS_LOG_LEVEL=INFO

# Local Model Provider & LLM Settings (M2 — Gemma 4 + Ollama)
MODEL_PROVIDER=ollama
MODEL_NAME=gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434
MODEL_TIMEOUT_SECONDS=120

# Retrieval Mode & Provider Settings (M4A — Live NPPES)
# Options: 'live' (queries public NPPES registry & PubMed) or 'fixture' (isolated test fixtures)
RETRIEVAL_MODE=live
NPPES_API_URL=https://npiregistry.cms.hhs.gov/api/
NPPES_TIMEOUT_SECONDS=10
NPPES_MAX_RETRIES=2

# Biomedical Research & Literature Settings (M4B — Live PubMed E-utilities)
PUBMED_API_URL=https://eutils.ncbi.nlm.nih.gov/entrez/eutils/
PUBMED_TIMEOUT_SECONDS=10
PUBMED_MAX_RETRIES=2
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=open-healthcare-agentic-platform

# Clinician & Facility Quality Metrics Settings (M4C — CMS Provider Data Catalog)
CMS_API_URL=https://data.cms.gov/provider-data/api/1/
CMS_TIMEOUT_SECONDS=15
CMS_MAX_RETRIES=3

# Patient Education Settings (M4D — MedlinePlus Web Service & Connect)
MEDLINEPLUS_API_URL=https://wsearch.nlm.nih.gov/ws/query
MEDLINEPLUS_CONNECT_URL=https://connect.medlineplus.gov/service
MEDLINEPLUS_TIMEOUT_SECONDS=10
MEDLINEPLUS_CACHE_TTL_SECONDS=43200
MEDLINEPLUS_MAX_RETRIES=3

# Web Application & Gateway Settings (M5 — FastAPI & Streamlit)
HEALTHCARE_AGENTS_API_URL=http://127.0.0.1:8000
HEALTHCARE_AGENTS_API_HOST=127.0.0.1
HEALTHCARE_AGENTS_API_PORT=8000
HEALTHCARE_AGENTS_UI_PORT=8501
